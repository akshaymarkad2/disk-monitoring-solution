AWSTemplateFormatVersion: '2010-09-09'
Description: Standardized CloudWatch Disk Utilization Alarm

Resources:
  DiskAlarm:
    Type: AWS::CloudWatch::Alarm
    Properties:
      AlarmName: "HighDiskUsage-{{ instance_id }}-{{ mount_path | default('root') | replace('/', '_') }}"
      AlarmDescription: "Triggers when disk utilization exceeds {{ threshold | default(85) }}% on {{ instance_id }} ({{ mount_path | default('/') }})"
      MetricName: "{{ metric_name | default('disk_used_percent') }}"
      Namespace: "{{ namespace | default('DiskMonitoring') }}"
      Statistic: Average
      Period: 300
      EvaluationPeriods: 3
      Threshold: {{ threshold | default(85) }}
      ComparisonOperator: GreaterThanOrEqualToThreshold
      Dimensions:
        - Name: InstanceId
          Value: "{{ instance_id }}"
        - Name: path
          Value: "{{ mount_path | default('/') }}"
      AlarmActions:
        - "{{ alarm_sns_arn | default('arn:aws:sns:' + region + ':' + account_id + ':DiskAlertTopic') }}"
      OKActions:
        - "{{ alarm_sns_arn | default('arn:aws:sns:' + region + ':' + account_id + ':DiskAlertTopic') }}"
      TreatMissingData: notBreaching
